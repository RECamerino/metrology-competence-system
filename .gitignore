# taxonomy edit, and the template plus the build script are the real source.
apps/viewer/index.html
apps/viewer/fragment.html

# Local databases and wallets — NEVER commit; may contain PII or private keys
*.sqlite
*.sqlite3
*.db
wallets/
keys/
*.pem
*.p12
*.pfx
*.jwk

# Organization overlay data — proprietary by definition, never upstream
overlays/
content/**/local/

# Environment
.env
.env.*
!.env.example

# Editor / OS
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

